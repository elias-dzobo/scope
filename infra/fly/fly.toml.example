# Fly.io backend deployment template for Scope.
#
# Recommended shape:
# - one Fly app for API + worker process groups
# - Postgres via Fly Managed Postgres or an external managed Postgres
# - artifacts via S3-compatible storage such as Tigris/R2/S3/MinIO elsewhere
# - frontend can be deployed separately as static web, or served by another Fly app

app = "scope-api"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
  SCOPE_ENV = "production"
  SCOPE_REQUIRE_AUTH = "true"
  SCOPE_AUTO_MIGRATE = "false"
  SCOPE_DB_BACKEND = "postgres"
  RESEARCH_EXECUTION_BACKEND = "durable"
  RESEARCH_MAX_WORKERS = "0"
  RESEARCH_LEASE_SECONDS = "300"
  RESEARCH_HEARTBEAT_SECONDS = "30"
  RESEARCH_WORKER_POLL_SECONDS = "2"
  ARTIFACT_STORE_BACKEND = "s3"
  ARTIFACT_PREFIX = "prod"
  ARTIFACT_RETENTION_MODE = "ephemeral"
  ARTIFACT_KEEP_TYPES = "final_synthesis,document_evidence"
  ARTIFACT_TEMP_TTL_HOURS = "72"
  ARTIFACT_KEEP_FAILED_RUNS_DAYS = "14"
  ARTIFACT_KEEP_RAW_DOCUMENTS = "false"
  OBSERVABILITY_ENABLED = "false"

[processes]
  web = "python api_main.py"
  worker = "python -m scope_api.worker"

[deploy]
  release_command = "python scripts/migrate_db.py"

[http_service]
  processes = ["web"]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "suspend"
  auto_start_machines = true
  min_machines_running = 1

  [http_service.concurrency]
    type = "requests"
    soft_limit = 20
    hard_limit = 40

  [[http_service.checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "20s"
    method = "GET"
    path = "/health"

[[vm]]
  processes = ["web"]
  size = "shared-cpu-1x"
  memory = "1gb"

[[vm]]
  processes = ["worker"]
  size = "shared-cpu-2x"
  memory = "2gb"

[[restart]]
  processes = ["worker"]
  policy = "always"
  retries = 10
