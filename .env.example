# Scope local development defaults

# API keys
OPENAI_API_KEY=
EXA_API_KEY=
GEMINI_API_KEY=

# Optional API protection
RESEARCH_API_KEY=
SCOPE_ENV=local
SCOPE_ALLOWED_ORIGINS=
SCOPE_REQUIRE_AUTH=false
SCOPE_MAX_BODY_BYTES=26214400

# Auth
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_ISSUER=scope
JWT_AUDIENCE=scope-web
JWT_EXPIRES_MINUTES=1440
AUTH_ALLOW_DEV_GOOGLE_TOKEN=false
VITE_GOOGLE_CLIENT_ID=

# Local runtime storage
SCOPE_STORAGE_DIR=storage
SCOPE_ARTIFACTS_DIR=storage/artifacts
ARTIFACT_STORE_BACKEND=local
ARTIFACT_BUCKET=
ARTIFACT_PREFIX=scope
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ARTIFACT_RETENTION_MODE=ephemeral
ARTIFACT_KEEP_TYPES=final_synthesis,document_evidence
ARTIFACT_TEMP_TTL_HOURS=72
ARTIFACT_KEEP_FAILED_RUNS_DAYS=14
ARTIFACT_KEEP_RAW_DOCUMENTS=false
SCOPE_DB_BACKEND=sqlite
SCOPE_DB_PATH=storage/research_runs.db
DATABASE_URL=
SCOPE_AUTO_MIGRATE=false

# Research orchestration
RESEARCH_MAX_WORKERS=2
RESEARCH_EXECUTION_BACKEND=in_process
RESEARCH_QUEUE_DEPTH=200
RESEARCH_MAX_RETRIES=1
RESEARCH_RETRY_BASE_SECONDS=2
RESEARCH_LEASE_SECONDS=300
RESEARCH_HEARTBEAT_SECONDS=30
RESEARCH_WORKER_POLL_SECONDS=2
RESEARCH_DAILY_LIMIT_PER_USER=10
RESEARCH_MAX_ACTIVE_RUNS_PER_USER=2
SCOPE_PRICING_MODEL=hybrid_subscription_credits
RESEARCH_COMPANY_BASE_CREDITS=5
RESEARCH_PROVIDER_CALL_BUDGET=80
RESEARCH_TOKEN_BUDGET=150000
RESEARCH_DOCUMENT_BUDGET=25

# Search providers
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Browser rendering fallback
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=
