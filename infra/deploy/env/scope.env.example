SCOPE_ENV=production
SCOPE_ALLOWED_ORIGINS=https://scope.example.com
SCOPE_REQUIRE_AUTH=true
SCOPE_AUTO_MIGRATE=false
SCOPE_MAX_BODY_BYTES=26214400

OPENAI_API_KEY=
EXA_API_KEY=
GEMINI_API_KEY=
SEARCH_PROVIDER=auto

GOOGLE_CLIENT_ID=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=scope
JWT_AUDIENCE=scope-web
JWT_EXPIRES_MINUTES=15
AUTH_ALLOW_DEV_GOOGLE_TOKEN=false

SCOPE_DB_BACKEND=postgres
DATABASE_URL=postgresql://scope_user:replace-me@127.0.0.1:5432/scope

SCOPE_STORAGE_DIR=/var/lib/scope
SCOPE_ARTIFACTS_DIR=/var/lib/scope/artifacts
ARTIFACT_STORE_BACKEND=minio
ARTIFACT_BUCKET=scope-artifacts
ARTIFACT_PREFIX=prod
ARTIFACT_S3_ENDPOINT_URL=http://127.0.0.1:9000
ARTIFACT_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=scope_minio
AWS_SECRET_ACCESS_KEY=
ARTIFACT_RETENTION_MODE=ephemeral
ARTIFACT_KEEP_TYPES=final_synthesis,document_evidence
ARTIFACT_TEMP_TTL_HOURS=72
ARTIFACT_KEEP_FAILED_RUNS_DAYS=14
ARTIFACT_KEEP_RAW_DOCUMENTS=false

RESEARCH_MAX_WORKERS=2
RESEARCH_EXECUTION_BACKEND=durable
RESEARCH_QUEUE_DEPTH=200
RESEARCH_MAX_RETRIES=1
RESEARCH_RETRY_BASE_SECONDS=2
RESEARCH_LEASE_SECONDS=300
RESEARCH_HEARTBEAT_SECONDS=30
RESEARCH_WORKER_POLL_SECONDS=2
RESEARCH_DAILY_LIMIT_PER_USER=10
RESEARCH_MAX_ACTIVE_RUNS_PER_USER=2
SCOPE_PRICING_MODEL=hybrid_subscription_credits
RESEARCH_COMPANY_BASE_CREDITS=5
RESEARCH_PROVIDER_CALL_BUDGET=80
RESEARCH_TOKEN_BUDGET=150000
RESEARCH_DOCUMENT_BUDGET=25

OBSERVABILITY_ENABLED=false
OBSERVABILITY_METRICS_ENABLED=true
OTEL_TRACES_ENABLED=false
